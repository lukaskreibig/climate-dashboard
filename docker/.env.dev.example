# Database
POSTGRES_DB=climate
POSTGRES_USER=climate
POSTGRES_PASSWORD=climate

# Backend
# The chatbot runs on OpenRouter; OPENAI_API_KEY is only the fallback when
# no OpenRouter key is set. Neither is needed unless you want the chatbot.
OPENROUTER_API_KEY=replace-me
PORT=8000
SEAICE_SMOOTH_WINDOW=11
SEAICE_ANOM_BASELINE_START=1981
SEAICE_ANOM_BASELINE_END=2010
SEAICE_DECADAL_SMOOTH=15

# Frontend
BACKEND_INTERNAL_URL=http://localhost:8000
